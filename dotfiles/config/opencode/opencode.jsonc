{
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "mcp": {
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem"],
      "enabled": true
    },
    "twitter": {
      "type": "local",
      "command": ["npx", "-y", "agent-twitter-client-mcp"],
      "enabled": true
    }
  },
  "instructions": [
    "rules/code-implementation.md",
    "rules/commit-guidelines.md"
  ]
}
