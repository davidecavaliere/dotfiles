{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/kimi-k2.7-code",
  "share": "disabled",
  "lsp": true,
  "plugin": [
    ["@vectorize-io/opencode-hindsight", {
      "hindsightApiUrl": "http://localhost:9077",
      "dynamicBankId": true,
      "dynamicBankGranularity": ["gitProject"],
      "retainContext": "opencode"
    }]
  ],
  "agent": {
    "watson": {
      "model": "opencode-go/minimax-m2.7",
      "mode": "primary",
      "permission": {
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "build": {
      "model": "opencode-go/glm-5.2",
      "mode": "primary"
    },
    "hermes": {
      "model": "github-copilot/gpt-5.2-codex"
    },
    "ask": {
      "model": "github-copilot/gemini-2.5-pro"
    },
    "sight": {
      "model": "github-copilot/gpt-4.1"
    }
  },
  "mcp": {
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "/usr/bin/codebase-memory-mcp"
      ]
    },
    "serena": {
      "enabled": true,
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--no-webui"
      ]
    },
    "math-mcp": {
      "type": "local",
      "command": ["npx", "-y", "math-mcp"],
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "git-mcp": {
      "type": "remote",
      "url": "https://gitmcp.io/docs"
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem"],
      "enabled": true
    },
    "twitter": {
      "type": "local",
      "command": ["npx", "-y", "agent-twitter-client-mcp"],
      "enabled": false
    },
    "web-search": {
      "type": "local",
      "command": ["npx", "-y", "@zhafron/mcp-web-search"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "node-debugger": {
      "type": "local",
      "command": ["npx", "-y", "@hyperdrive-eng/mcp-nodejs-debugger"],
      "enabled": true
    }
  },
  "instructions": [
    "rules/tone.md",
    "rules/watson.md"
  ]
}
