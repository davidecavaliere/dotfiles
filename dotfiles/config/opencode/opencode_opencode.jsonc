{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "agent": {
    "build": {
      "model": "opencode/kimi-k2.5-free",
      "mode": "primary"
    },
    "ai-e2e-runner": {
      "model": "opencode/glm-4.7-free"
    },
    "orchestrator": {
      "model": "opencode/glm-4.7-free"
    },
    "slave": {
      "model": "opencode/kimi-k2.5-free"
    },
    "designer": {
      "model": "opencode/glm-4.7-free"
    },
    "xposter": {
      "model": "opencode/kimi-k2.5-free"
    },
    "hermes": {
      "model": "opencode/kimi-k2.5-free"
    },
    "ask": {
      "model": "opencode/kimi-k2.5-free"
    }
  },
  "mcp": {
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "git-mcp": {
      "type": "remote",
      "url": "https://gitmcp.io/docs"
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem"],
      "enabled": true
    },
    "twitter": {
      "type": "local",
      "command": ["npx", "-y", "agent-twitter-client-mcp"],
      "enabled": true
    },
    "tmux": {
      "type": "local",
      "command": ["npx", "-y", "tmux-mcp"],
      "enabled": true
    }
  },
  "instructions": [
    "rules/tone.md",
    "rules/code-implementation.md",
    "rules/commit-guidelines.md"
  ]
}
